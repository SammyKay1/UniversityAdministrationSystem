@page "/administration/departments"

@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization

@attribute [Authorize(Policy = Permissions.Departments.View)]

@inject DialogService DialogService
@inject DepartmentService DepartmentService
@inject NavigationManager Navigation

<PageTitle>Departments</PageTitle>


<div class="container-fluid">

    <!-- Header -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h1 class="mb-1">
                Departments
            </h1>

            <p class="text-muted mb-0">
                Manage academic departments and their information.
            </p>

        </div>


        <AuthorizeView Policy="@Permissions.Departments.Create">

            <Authorized>

                <button class="btn btn-primary"
                        @onclick="CreateDepartment">

                    <i class="bi bi-plus-lg me-1"></i>

                    New Department

                </button>

            </Authorized>

        </AuthorizeView>

    </div>


    <!-- Error -->

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger">

            <i class="bi bi-exclamation-triangle me-2"></i>

            @errorMessage

        </div>
    }


    <!-- Search -->

    <div class="card mb-4">

        <div class="card-body">

            <div class="row g-3 align-items-end">

                <div class="col-md-6">

                    <label class="form-label">
                        Search Departments
                    </label>

                    <div class="input-group">

                        <span class="input-group-text">
                            <i class="bi bi-search"></i>
                        </span>

                        <input class="form-control"
                               placeholder="Search by code, name or email..."
                               @bind="searchTerm"
                               @bind:event="oninput" />

                    </div>

                </div>

            </div>

        </div>


        <!-- Results Summary -->

        <div class="card-footer bg-white">

            <div class="d-flex justify-content-between align-items-center">

                <div>

                    <strong>
                        Departments
                    </strong>

                    <span class="text-muted ms-2">

                        @FilteredDepartments.Count() result(s)

                    </span>

                </div>


                @if (!string.IsNullOrWhiteSpace(searchTerm))
                {
                    <button class="btn btn-sm btn-outline-secondary"
                            @onclick="ClearSearch">

                        <i class="bi bi-x-lg me-1"></i>

                        Clear

                    </button>
                }

            </div>

        </div>

    </div>


    <!-- Department Table -->

    <div class="card">

        @if (departments is null)
        {
            <!-- Loading -->

            <div class="card-body text-center py-5">

                <div class="spinner-border"
                     role="status">
                </div>

                <p class="text-muted mt-3 mb-0">
                    Loading departments...
                </p>

            </div>
        }
        else if (!FilteredDepartments.Any())
        {
            <!-- Empty -->

            <div class="card-body text-center py-5">

                <i class="bi bi-building fs-1 text-muted"></i>

                <h5 class="mt-3">
                    No departments found
                </h5>

                <p class="text-muted mb-0">

                    @if (string.IsNullOrWhiteSpace(searchTerm))
                    {
                        <span>
                            There are currently no departments.
                        </span>
                    }
                    else
                    {
                        <span>
                            No departments match your search.
                        </span>
                    }

                </p>

            </div>
        }
        else
        {
            <!-- Table -->

            <div class="card-body p-0">

                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">

                            <tr>

                                <th>
                                    Code
                                </th>

                                <th>
                                    Department
                                </th>

                                <th>
                                    Description
                                </th>

                                <th>
                                    Email
                                </th>

                                <th class="text-end">
                                    Actions
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            @foreach (var department in FilteredDepartments)
                            {
                                <tr>

                                    <!-- Code -->

                                    <td>

                                        <span class="badge bg-secondary">

                                            @department.Code

                                        </span>

                                    </td>


                                    <!-- Name -->

                                    <td>

                                        <div class="fw-semibold">

                                            @department.Name

                                        </div>

                                    </td>


                                    <!-- Description -->

                                    <td>

                                        @if (string.IsNullOrWhiteSpace(
                                            department.Description))
                                        {
                                            <span class="text-muted">
                                                No description
                                            </span>
                                        }
                                        else
                                        {
                                            <span title="@department.Description">

                                                @GetShortDescription(
                                                    department.Description)

                                            </span>
                                        }

                                    </td>


                                    <!-- Email -->

                                    <td>

                                        @if (string.IsNullOrWhiteSpace(
                                            department.Email))
                                        {
                                            <span class="text-muted">
                                                —
                                            </span>
                                        }
                                        else
                                        {
                                            <a href="mailto:@department.Email">

                                                @department.Email

                                            </a>
                                        }

                                    </td>


                                    <!-- Actions -->

                                    <td class="text-end">

                                        <div class="d-flex justify-content-end gap-1">

                                            <!-- View -->

                                            <button type="button"
                                                    class="btn btn-sm btn-outline-primary"
                                                    title="View department"
                                                    @onclick="() => ViewDepartment(department.Id)">

                                                <i class="bi bi-eye"></i>

                                                <span class="d-none d-md-inline ms-1">
                                                    View
                                                </span>

                                            </button>


                                            <!-- Edit -->

                                            <AuthorizeView Policy="@Permissions.Departments.Edit">

                                                <Authorized>

                                                    <button type="button"
                                                            class="btn btn-sm btn-outline-secondary"
                                                            title="Edit department"
                                                            @onclick="() => EditDepartment(department.Id)">

                                                        <i class="bi bi-pencil"></i>

                                                        <span class="d-none d-md-inline ms-1">
                                                            Edit
                                                        </span>

                                                    </button>

                                                </Authorized>

                                            </AuthorizeView>


                                            <!-- Archive -->

                                            <AuthorizeView Policy="@Permissions.Departments.Archive">

                                                <Authorized>

                                                    <button type="button"
                                                            class="btn btn-sm btn-outline-danger"
                                                            title="Archive department"
                                                            @onclick="() => ArchiveDepartment(department.Id)">

                                                        <i class="bi bi-archive"></i>

                                                        <span class="d-none d-md-inline ms-1">
                                                            Archive
                                                        </span>

                                                    </button>

                                                </Authorized>

                                            </AuthorizeView>

                                        </div>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>


            <!-- Table Footer -->

            <div class="card-footer">

                <div class="text-muted">

                    Showing
                    <strong>@FilteredDepartments.Count()</strong>
                    department(s)

                </div>

            </div>
        }

    </div>

</div>


@code {

    private IEnumerable<DepartmentDto>? departments;

    private string searchTerm = "";

    private string? errorMessage;


    protected override async Task OnInitializedAsync()
    {
        await LoadDepartmentsAsync();
    }


    private async Task LoadDepartmentsAsync()
    {
        try
        {
            errorMessage = null;

            departments =
                await DepartmentService
                    .GetAllAsync();
        }
        catch (Exception)
        {
            errorMessage =
                "Unable to load departments.";
        }
    }


    private IEnumerable<DepartmentDto> FilteredDepartments
    {
        get
        {
            if (departments is null)
                return Enumerable.Empty<DepartmentDto>();


            if (string.IsNullOrWhiteSpace(searchTerm))
                return departments;


            return departments.Where(d =>
                (!string.IsNullOrWhiteSpace(d.Name) &&
                 d.Name.Contains(
                     searchTerm,
                     StringComparison.OrdinalIgnoreCase))

                ||

                (!string.IsNullOrWhiteSpace(d.Code) &&
                 d.Code.Contains(
                     searchTerm,
                     StringComparison.OrdinalIgnoreCase))

                ||

                (!string.IsNullOrWhiteSpace(d.Email) &&
                 d.Email.Contains(
                     searchTerm,
                     StringComparison.OrdinalIgnoreCase))

                ||

                (!string.IsNullOrWhiteSpace(d.Description) &&
                 d.Description.Contains(
                     searchTerm,
                     StringComparison.OrdinalIgnoreCase)));
        }
    }


    private string GetShortDescription(string description)
    {
        const int maxLength = 70;

        if (description.Length <= maxLength)
            return description;

        return description[..maxLength] + "...";
    }


    private void ClearSearch()
    {
        searchTerm = "";
    }


    private void CreateDepartment()
    {
        Navigation.NavigateTo(
            "/administration/departments/create");
    }


    private void ViewDepartment(int id)
    {
        Navigation.NavigateTo(
            $"/administration/departments/{id}");
    }


    private void EditDepartment(int id)
    {
        Navigation.NavigateTo(
            $"/administration/departments/edit/{id}");
    }


    private async Task ArchiveDepartment(int id)
    {
        var department =
            departments?
                .FirstOrDefault(d => d.Id == id);

        if (department is null)
            return;


        var confirmed =
            await DialogService.ConfirmAsync(
                "Archive Department",
                $"Are you sure you want to archive " +
                $"the '{department.Name}' department?");


        if (!confirmed)
            return;


        try
        {
            errorMessage = null;


            await DepartmentService
                .ArchiveAsync(id);


            await LoadDepartmentsAsync();
        }
        catch (InvalidOperationException ex)
        {
            errorMessage = ex.Message;
        }
        catch (Exception)
        {
            errorMessage =
                "Unable to archive the department.";
        }
    }

}
