@page "/administration/departments/edit/{Id:int}"

@using UniversityAdministrationSystem.Components.Shared
@using UniversityAdministrationSystem.Components.Shared.Layout
@using Microsoft.AspNetCore.Authorization

@attribute [Authorize(Policy = Permissions.Departments.Edit)]

@inject DepartmentService DepartmentService
@inject NavigationManager Navigation

<PageTitle>Edit Department</PageTitle>


<div class="container-fluid">

    <!-- Header -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h1>Edit Department</h1>

            <p class="text-muted mb-0">
                Update department information and settings.
            </p>

        </div>


        <button class="btn btn-outline-secondary"
                @onclick="Cancel">

            <i class="bi bi-arrow-left me-1"></i>

            Back

        </button>

    </div>


    <!-- Error -->

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger">

            <i class="bi bi-exclamation-triangle me-2"></i>

            @errorMessage

        </div>
    }


    <!-- Loading -->

    @if (isLoading)
    {
        <PageCard>

            <div class="text-center py-5">

                <div class="spinner-border text-primary"
                     role="status">
                </div>

                <p class="text-muted mt-3 mb-0">
                    Loading department...
                </p>

            </div>

        </PageCard>
    }
    else if (department is null)
    {
        <!-- Not Found -->

        <PageCard>

            <div class="text-center py-5">

                <i class="bi bi-building-x fs-1 text-muted"></i>

                <h5 class="mt-3">
                    Department not found
                </h5>

                <p class="text-muted">
                    The requested department could not be found.
                </p>

                <button class="btn btn-primary"
                        @onclick="Cancel">

                    <i class="bi bi-arrow-left me-1"></i>

                    Back to Departments

                </button>

            </div>

        </PageCard>
    }
    else
    {
        <!-- Department Form -->

        <PageCard>

            <div class="mb-4">

                <h5 class="fw-semibold mb-1">

                    <i class="bi bi-building me-2"></i>

                    Department Information

                </h5>

                <p class="text-muted mb-0">
                    Update the department's basic information.
                </p>

            </div>


            <EditForm Model="department"
                      FormName="EditDepartmentForm"
                      OnValidSubmit="UpdateDepartmentAsync">

                <DataAnnotationsValidator />

                <ValidationSummary />


                <div class="row g-4">

                    <!-- Name -->

                    <div class="col-md-6">

                        <label class="form-label">
                            Department Name
                        </label>

                        <InputText class="form-control"
                                   @bind-Value="department.Name" />

                        <ValidationMessage
                            For="@(() => department.Name)" />

                    </div>


                    <!-- Code -->

                    <div class="col-md-6">

                        <label class="form-label">
                            Department Code
                        </label>

                        <InputText class="form-control"
                                   @bind-Value="department.Code" />

                        <ValidationMessage
                            For="@(() => department.Code)" />

                        <div class="form-text">
                            The department code must be unique.
                            Example: CS, MATH, BUS.
                        </div>

                    </div>


                    <!-- Email -->

                    <div class="col-md-6">

                        <label class="form-label">
                            Department Email
                        </label>

                        <InputText type="email"
                                   class="form-control"
                                   @bind-Value="department.Email" />

                        <ValidationMessage
                            For="@(() => department.Email)" />

                    </div>


                    <!-- Description -->

                    <div class="col-12">

                        <label class="form-label">
                            Description
                        </label>

                        <InputTextArea class="form-control"
                                       rows="5"
                                       @bind-Value="department.Description" />

                        <ValidationMessage
                            For="@(() => department.Description)" />

                    </div>

                </div>


                <!-- Actions -->

                <div class="d-flex justify-content-end gap-2 mt-4">

                    <button type="button"
                            class="btn btn-secondary"
                            @onclick="Cancel"
                            disabled="@isSaving">

                        <i class="bi bi-x-lg me-1"></i>

                        Cancel

                    </button>


                    <button type="submit"
                            class="btn btn-primary"
                            disabled="@isSaving">

                        @if (isSaving)
                        {
                            <span class="spinner-border
                                         spinner-border-sm me-1">
                            </span>

                            <span>Saving...</span>
                        }
                        else
                        {
                            <i class="bi bi-check-lg me-1"></i>

                            <span>Save Changes</span>
                        }

                    </button>

                </div>

            </EditForm>

        </PageCard>
    }

</div>


@code {

    [Parameter]
    public int Id { get; set; }


    private DepartmentDto? department;

    private bool isLoading = true;

    private bool isSaving;

    private string? errorMessage;


    protected override async Task OnParametersSetAsync()
    {
        await LoadDepartmentAsync();
    }


    private async Task LoadDepartmentAsync()
    {
        isLoading = true;
        errorMessage = null;
        department = null;

        try
        {
            department =
                await DepartmentService
                    .GetByIdAsync(Id);
        }
        catch (Exception)
        {
            errorMessage =
                "Unable to load the department.";
        }
        finally
        {
            isLoading = false;
        }
    }


    private async Task UpdateDepartmentAsync()
    {
        if (department is null || isSaving)
            return;


        isSaving = true;
        errorMessage = null;


        try
        {
            department.Name =
                department.Name.Trim();

            department.Code =
                department.Code
                    .Trim()
                    .ToUpperInvariant();

            department.Email =
                department.Email?.Trim() ?? string.Empty;

            department.Description =
                department.Description?.Trim() ?? string.Empty;


            await DepartmentService
                .UpdateAsync(department);


            Navigation.NavigateTo(
                "/administration/departments");
        }
        catch (InvalidOperationException ex)
        {
            errorMessage = ex.Message;
        }
        catch (Exception)
        {
            errorMessage =
                "Unable to update the department. " +
                "Please try again.";
        }
        finally
        {
            isSaving = false;
        }
    }


    private void Cancel()
    {
        Navigation.NavigateTo(
            "/administration/departments");
    }

}
