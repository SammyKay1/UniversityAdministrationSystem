@page "/administration/departments/{Id:int}"

@using UniversityAdministrationSystem.Components.Shared
@using UniversityAdministrationSystem.Components.Shared.Layout
@using Microsoft.AspNetCore.Authorization

@attribute [Authorize(Policy = Permissions.Departments.View)]

@inject DepartmentService DepartmentService
@inject NavigationManager Navigation

<PageTitle>Department Details</PageTitle>


<div class="container-fluid">

    <!-- Header -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h1>Department Details</h1>

            <p class="text-muted mb-0">
                View department information and academic statistics.
            </p>

        </div>


        <div class="d-flex gap-2">

            <button class="btn btn-outline-secondary"
                    @onclick="BackToDepartments">

                <i class="bi bi-arrow-left me-1"></i>

                Back

            </button>


            <AuthorizeView Policy="@Permissions.Departments.Edit">

                <Authorized>

                    @if (department is not null)
                    {
                        <button class="btn btn-primary"
                                @onclick="EditDepartment">

                            <i class="bi bi-pencil me-1"></i>

                            Edit Department

                        </button>
                    }

                </Authorized>

            </AuthorizeView>

        </div>

    </div>


    <!-- Loading -->

    @if (isLoading)
    {
        <PageCard>

            <div class="text-center py-5">

                <div class="spinner-border text-primary"
                     role="status">
                </div>

                <p class="text-muted mt-3 mb-0">
                    Loading department...
                </p>

            </div>

        </PageCard>
    }
    else if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <PageCard>

            <div class="text-center py-5">

                <i class="bi bi-exclamation-triangle
                          fs-1 text-danger">
                </i>

                <h5 class="mt-3">
                    Unable to load department
                </h5>

                <p class="text-muted">
                    @errorMessage
                </p>

                <button class="btn btn-secondary"
                        @onclick="BackToDepartments">

                    <i class="bi bi-arrow-left me-1"></i>

                    Back to Departments

                </button>

            </div>

        </PageCard>
    }
    else if (department is null)
    {
        <PageCard>

            <div class="text-center py-5">

                <i class="bi bi-building-x
                          fs-1 text-muted">
                </i>

                <h5 class="mt-3">
                    Department not found
                </h5>

                <p class="text-muted">
                    The requested department could not be found.
                </p>

                <button class="btn btn-primary"
                        @onclick="BackToDepartments">

                    <i class="bi bi-arrow-left me-1"></i>

                    Back to Departments

                </button>

            </div>

        </PageCard>
    }
    else
    {
        <div class="row g-4">

            <!-- Department Information -->

            <div class="col-lg-8">

                <PageCard>

                    <!-- Department Identity -->

                    <div class="d-flex align-items-center mb-4">

                        <div class="rounded-circle
                                    bg-primary-subtle
                                    text-primary
                                    d-flex align-items-center
                                    justify-content-center me-3"
                             style="width:70px;height:70px;font-size:28px;">

                            <i class="bi bi-building"></i>

                        </div>


                        <div>

                            <h3 class="fw-bold mb-1">
                                @department.Name
                            </h3>

                            <span class="badge bg-secondary">
                                @department.Code
                            </span>

                        </div>

                    </div>


                    <hr />


                    <h5 class="fw-semibold mb-4">

                        <i class="bi bi-info-circle me-2"></i>

                        Department Information

                    </h5>


                    <div class="row g-4">

                        <!-- Name -->

                        <div class="col-md-6">

                            <label class="text-muted small">
                                Department Name
                            </label>

                            <div class="fw-semibold">
                                @department.Name
                            </div>

                        </div>


                        <!-- Code -->

                        <div class="col-md-6">

                            <label class="text-muted small">
                                Department Code
                            </label>

                            <div class="fw-semibold">
                                @department.Code
                            </div>

                        </div>


                        <!-- Email -->

                        <div class="col-md-6">

                            <label class="text-muted small">
                                Department Email
                            </label>

                            @if (string.IsNullOrWhiteSpace(
                                department.Email))
                            {
                                <div class="text-muted">
                                    Not provided
                                </div>
                            }
                            else
                            {
                                <div>

                                    <a href="mailto:@department.Email">
                                        @department.Email
                                    </a>

                                </div>
                            }

                        </div>


                        <!-- Description -->

                        <div class="col-12">

                            <label class="text-muted small">
                                Description
                            </label>

                            @if (string.IsNullOrWhiteSpace(
                                department.Description))
                            {
                                <div class="text-muted">
                                    No description provided.
                                </div>
                            }
                            else
                            {
                                <p class="mb-0">
                                    @department.Description
                                </p>
                            }

                        </div>

                    </div>

                </PageCard>

            </div>


            <!-- Statistics -->

            <div class="col-lg-4">

                <div class="row g-4">

                    <!-- Students -->

                    <div class="col-12">

                        <PageCard>

                            <div class="d-flex
                                        justify-content-between
                                        align-items-center">

                                <div>

                                    <div class="text-muted small">
                                        Students
                                    </div>

                                    <div class="fs-2 fw-bold">
                                        @department.StudentCount
                                    </div>

                                    <small class="text-muted">
                                        Enrolled students
                                    </small>

                                </div>


                                <div class="rounded-circle
                                            bg-primary-subtle
                                            text-primary
                                            d-flex align-items-center
                                            justify-content-center"
                                     style="width:55px;height:55px;">

                                    <i class="bi bi-people fs-4"></i>

                                </div>

                            </div>

                        </PageCard>

                    </div>


                    <!-- Teachers -->

                    <div class="col-12">

                        <PageCard>

                            <div class="d-flex
                                        justify-content-between
                                        align-items-center">

                                <div>

                                    <div class="text-muted small">
                                        Teachers
                                    </div>

                                    <div class="fs-2 fw-bold">
                                        @department.TeacherCount
                                    </div>

                                    <small class="text-muted">
                                        Assigned teachers
                                    </small>

                                </div>


                                <div class="rounded-circle
                                            bg-success-subtle
                                            text-success
                                            d-flex align-items-center
                                            justify-content-center"
                                     style="width:55px;height:55px;">

                                    <i class="bi bi-person-workspace fs-4"></i>

                                </div>

                            </div>

                        </PageCard>

                    </div>

                </div>

            </div>

        </div>
    }

</div>


@code {

    [Parameter]
    public int Id { get; set; }


    private DepartmentDto? department;

    private bool isLoading = true;

    private string? errorMessage;


    protected override async Task OnParametersSetAsync()
    {
        await LoadDepartmentAsync();
    }


    private async Task LoadDepartmentAsync()
    {
        isLoading = true;
        errorMessage = null;
        department = null;


        try
        {
            department =
                await DepartmentService
                    .GetByIdAsync(Id);
        }
        catch (Exception)
        {
            errorMessage =
                "Unable to load department information.";
        }
        finally
        {
            isLoading = false;
        }
    }


    private void EditDepartment()
    {
        Navigation.NavigateTo(
            $"/administration/departments/edit/{Id}");
    }


    private void BackToDepartments()
    {
        Navigation.NavigateTo(
            "/administration/departments");
    }

}
