@page "/administration/teachers/edit/{Id:int}"

@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore

@attribute [Authorize(Policy = Permissions.Teachers.Edit)]

@inject TeacherService TeacherService
@inject DepartmentService DepartmentService
@inject NavigationManager Navigation

<PageTitle>Edit Teacher</PageTitle>


<div class="container-fluid">

    <!-- Header -->

    <div class="d-flex justify-content-between align-items-start mb-4">

        <div>

            <div class="text-muted small mb-1">

                <button type="button"
                        class="btn btn-link p-0 text-decoration-none"
                        @onclick="Cancel">

                    Teachers

                </button>

                <span class="mx-2">
                    /
                </span>

                Edit Teacher

            </div>


            <h1 class="mb-1">
                Edit Teacher
            </h1>

            <p class="text-muted mb-0">
                Update teacher information and department assignment.
            </p>

        </div>


        <button type="button"
                class="btn btn-outline-secondary"
                @onclick="Cancel"
                disabled="@isSaving">

            <i class="bi bi-arrow-left me-1"></i>

            Back

        </button>

    </div>


    <!-- Error -->

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger d-flex align-items-start"
             role="alert">

            <i class="bi bi-exclamation-triangle-fill me-2 mt-1"></i>

            <div>
                @errorMessage
            </div>

        </div>
    }


    <!-- Loading -->

    @if (isLoading)
    {
        <div class="card">

            <div class="card-body text-center py-5">

                <div class="spinner-border"
                     role="status">

                    <span class="visually-hidden">
                        Loading...
                    </span>

                </div>

                <p class="text-muted mt-3 mb-0">
                    Loading teacher information...
                </p>

            </div>

        </div>
    }
    else if (model is null)
    {
        <!-- Not Found -->

        <div class="card">

            <div class="card-body text-center py-5">

                <i class="bi bi-person-x fs-1 text-muted"></i>

                <h5 class="mt-3">
                    Teacher not found
                </h5>

                <p class="text-muted">
                    The requested teacher record could not be found.
                </p>

                <button type="button"
                        class="btn btn-primary"
                        @onclick="Cancel">

                    <i class="bi bi-arrow-left me-1"></i>

                    Back to Teachers

                </button>

            </div>

        </div>
    }
    else
    {
        <EditForm Model="model"
                  OnValidSubmit="UpdateTeacher">

            <DataAnnotationsValidator />


            <!-- Validation Summary -->

            <ValidationSummary class="alert alert-warning" />


            <div class="row g-4">

                <!-- Personal Information -->

                <div class="col-lg-8">

                    <div class="card h-100">

                        <div class="card-header bg-white">

                            <div class="d-flex align-items-center">

                                <div class="edit-section-icon">

                                    <i class="bi bi-person-vcard"></i>

                                </div>

                                <div>

                                    <h5 class="mb-1">
                                        Personal Information
                                    </h5>

                                    <p class="text-muted small mb-0">
                                        Update the teacher's basic information.
                                    </p>

                                </div>

                            </div>

                        </div>


                        <div class="card-body">

                            <div class="row g-4">

                                <!-- First Name -->

                                <div class="col-md-6">

                                    <label class="form-label">
                                        First Name
                                        <span class="text-danger">*</span>
                                    </label>

                                    <InputText class="form-control"
                                               @bind-Value="model.FirstName" />

                                    <ValidationMessage
                                        For="@(() => model.FirstName)" />

                                </div>


                                <!-- Last Name -->

                                <div class="col-md-6">

                                    <label class="form-label">
                                        Last Name
                                        <span class="text-danger">*</span>
                                    </label>

                                    <InputText class="form-control"
                                               @bind-Value="model.LastName" />

                                    <ValidationMessage
                                        For="@(() => model.LastName)" />

                                </div>


                                <!-- Email -->

                                <div class="col-md-6">

                                    <label class="form-label">
                                        Email
                                        <span class="text-danger">*</span>
                                    </label>

                                    <InputText type="email"
                                               class="form-control"
                                               @bind-Value="model.Email" />

                                    <ValidationMessage
                                        For="@(() => model.Email)" />

                                </div>


                                <!-- Date of Birth -->

                                <div class="col-md-6">

                                    <label class="form-label">
                                        Date of Birth
                                        <span class="text-danger">*</span>
                                    </label>

                                    <InputDate class="form-control"
                                               @bind-Value="model.DateOfBirth" />

                                    <ValidationMessage
                                        For="@(() => model.DateOfBirth)" />

                                </div>

                            </div>

                        </div>

                    </div>

                </div>


                <!-- Teacher Summary -->

                <div class="col-lg-4">

                    <div class="card h-100">

                        <div class="card-header bg-white">

                            <h5 class="mb-1">
                                Teacher
                            </h5>

                            <p class="text-muted small mb-0">
                                Current record
                            </p>

                        </div>


                        <div class="card-body">

                            <div class="text-center">

                                <div class="teacher-edit-avatar mx-auto mb-3">

                                    <i class="bi bi-person"></i>

                                </div>


                                <h5 class="fw-semibold mb-1">

                                    @model.FirstName
                                    @model.LastName

                                </h5>


                                <p class="text-muted mb-3">

                                    @model.Email

                                </p>


                                <div class="border-top pt-3 text-start">

                                    <div class="text-muted small">
                                        Teacher ID
                                    </div>

                                    <div class="fw-semibold">
                                        @model.Id
                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>


                <!-- Department Assignment -->

                <div class="col-12">

                    <div class="card">

                        <div class="card-header bg-white">

                            <div class="d-flex align-items-center">

                                <div class="edit-section-icon">

                                    <i class="bi bi-building"></i>

                                </div>

                                <div>

                                    <h5 class="mb-1">
                                        Department Assignment
                                    </h5>

                                    <p class="text-muted small mb-0">
                                        Assign the teacher to a university department.
                                    </p>

                                </div>

                            </div>

                        </div>


                        <div class="card-body">

                            <div class="row">

                                <div class="col-lg-6">

                                    <label class="form-label">
                                        Department
                                        <span class="text-danger">*</span>
                                    </label>


                                    <InputSelect class="form-select"
                                                 @bind-Value="model.DepartmentId">

                                        <option value="0">
                                            Select department
                                        </option>

                                        @foreach (var department in departments)
                                        {
                                            <option value="@department.Id">
                                                @department.Name
                                            </option>
                                        }

                                    </InputSelect>


                                    <ValidationMessage
                                        For="@(() => model.DepartmentId)" />

                                </div>

                            </div>

                        </div>

                    </div>

                </div>

            </div>


            <!-- Form Actions -->

            <div class="d-flex justify-content-between align-items-center mt-4">

                <div class="text-muted small">

                    <i class="bi bi-info-circle me-1"></i>

                    Fields marked with
                    <span class="text-danger">*</span>
                    are required.

                </div>


                <div class="d-flex gap-2">

                    <button type="button"
                            class="btn btn-outline-secondary"
                            @onclick="Cancel"
                            disabled="@isSaving">

                        Cancel

                    </button>


                    <button type="submit"
                            class="btn btn-primary"
                            disabled="@isSaving">

                        @if (isSaving)
                        {
                            <span class="spinner-border spinner-border-sm me-2"
                                  role="status">

                            </span>

                            <span>
                                Saving...
                            </span>
                        }
                        else
                        {
                            <i class="bi bi-check-lg me-1"></i>

                            <span>
                                Save Changes
                            </span>
                        }

                    </button>

                </div>

            </div>

        </EditForm>
    }

</div>


@code {

    [Parameter]
    public int Id { get; set; }


    private TeacherDto? model;


    private IEnumerable<DepartmentLookUpDto> departments =
        Enumerable.Empty<DepartmentLookUpDto>();


    private bool isLoading;

    private bool isSaving;

    private string? errorMessage;


    protected override async Task OnParametersSetAsync()
    {
        await LoadAsync();
    }


    private async Task LoadAsync()
    {
        try
        {
            isLoading = true;

            errorMessage = null;


            departments =
                await DepartmentService
                    .GetDepartmentsAsync();


            model =
                await TeacherService
                    .GetByIdAsync(Id);


            if (model is null)
            {
                errorMessage =
                    "Teacher could not be found.";
            }
        }
        catch (Exception)
        {
            errorMessage =
                "Unable to load teacher.";
        }
        finally
        {
            isLoading = false;
        }
    }


    private async Task UpdateTeacher()
    {
        if (model is null)
            return;


        if (model.DepartmentId <= 0)
        {
            errorMessage =
                "Please select a department.";

            return;
        }


        try
        {
            isSaving = true;

            errorMessage = null;


            await TeacherService
                .UpdateAsync(model);


            Navigation.NavigateTo(
                $"/administration/teachers/{Id}");
        }
        catch (InvalidOperationException ex)
        {
            errorMessage = ex.Message;
        }
        catch (DbUpdateConcurrencyException)
        {
            errorMessage =
                "This teacher was modified by another user. " +
                "Please reload the page and try again.";
        }
        catch (Exception)
        {
            errorMessage =
                "Unable to update the teacher.";
        }
        finally
        {
            isSaving = false;
        }
    }


    private void Cancel()
    {
        Navigation.NavigateTo(
            $"/administration/teachers/{Id}");
    }

}
