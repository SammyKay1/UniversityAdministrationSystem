@page "/students/details/{StudentId:int}"

@using UniversityAdministrationSystem.Components.Shared
@using UniversityAdministrationSystem.Components.Shared.Feedback
@using UniversityAdministrationSystem.Components.Shared.Layout
@using Microsoft.AspNetCore.Authorization

@inject StudentService StudentService
@inject NavigationManager Navigation
@inject NotificationService Notification

@attribute [Authorize(Policy = Permissions.Students.View)]


<NotificationContainer />


<div class="container-fluid">

    @if (loading)
    {
        <!-- Loading -->

        <div class="card">

            <div class="card-body text-center py-5">

                <div class="spinner-border"
                     role="status">

                    <span class="visually-hidden">
                        Loading...
                    </span>

                </div>

                <p class="text-muted mt-3 mb-0">
                    Loading student details...
                </p>

            </div>

        </div>
    }
    else if (student is null)
    {
        <!-- Not Found -->

        <div class="d-flex justify-content-between align-items-center mb-4">

            <div>

                <h1>
                    Student Details
                </h1>

                <p class="text-muted mb-0">
                    View and manage student information.
                </p>

            </div>

        </div>


        <div class="card">

            <div class="card-body text-center py-5">

                <i class="bi bi-person-x fs-1 text-muted"></i>

                <h5 class="mt-3"> Student not found </h5>

                <p class="text-muted">
                    The requested student record could not be found.
                </p>

                <button type="button"  class="btn btn-primary"   @onclick="GoBack">

                    <i class="bi bi-arrow-left me-1"></i>

                    Back to Students

                </button>

            </div>

        </div>
    }
    else
    {
        <!-- Header -->

        <div class="d-flex justify-content-between align-items-center mb-4">

            <div>

                <div class="text-muted small mb-1">

                    <button type="button"    class="btn btn-link p-0 text-decoration-none"
                            @onclick="GoBack">

                        Students

                    </button>

                    <span class="mx-2">
                        /
                    </span>

                    Student Details

                </div>


                <h1>
                    @student.FullName
                </h1>

                <p class="text-muted mb-0">
                    View and manage student information.
                </p>

            </div>


            <div class="d-flex gap-2">

                <button type="button"   class="btn btn-outline-secondary"   @onclick="GoBack">

                    <i class="bi bi-arrow-left me-1"></i>

                    Back

                </button>


                <button type="button"    class="btn btn-primary" @onclick="EditStudent">

                    <i class="bi bi-pencil me-1"></i>

                    Edit Student

                </button>

            </div>

        </div>


        <!-- Student Profile -->

        <div class="card mb-4">

            <div class="card-body">

                <div class="row align-items-center">

                    <div class="col-auto">

                        <div class="student-profile-avatar">

                            <i class="bi bi-person"></i>

                        </div>

                    </div>


                    <div class="col">

                        <h3 class="fw-semibold mb-1">
                            @student.FullName
                        </h3>

                        <p class="text-muted mb-2">
                            Student ID: @student.Id
                        </p>

                        <span class="badge bg-primary-subtle text-primary">
                            Student
                        </span>

                    </div>

                </div>

            </div>

        </div>


        <!-- Information -->

        <div class="row g-4">

            <!-- Personal Information -->

            <div class="col-lg-6">

                <div class="card h-100">

                    <div class="card-body">

                        <h5 class="fw-semibold mb-4">

                            <i class="bi bi-person-vcard me-2"></i>

                            Personal Information

                        </h5>


                        <div class="student-detail-item">

                            <div class="student-detail-label">
                                Full Name
                            </div>

                            <div class="student-detail-value">
                                @student.FullName
                            </div>

                        </div>


                        <div class="student-detail-item">

                            <div class="student-detail-label">
                                Email
                            </div>

                            <div class="student-detail-value">

                                <a href="mailto:@student.Email">
                                    @student.Email
                                </a>

                            </div>

                        </div>


                        <div class="student-detail-item">

                            <div class="student-detail-label">
                                Date of Birth
                            </div>

                            <div class="student-detail-value">
                                @student.DateOfBirth.ToString("dd MMMM yyyy")
                            </div>

                        </div>

                    </div>

                </div>

            </div>


            <!-- Academic Information -->

            <div class="col-lg-6">

                <div class="card h-100">

                    <div class="card-body">

                        <h5 class="fw-semibold mb-4">

                            <i class="bi bi-mortarboard me-2"></i>

                            Academic Information

                        </h5>


                        <div class="student-detail-item">

                            <div class="student-detail-label">
                                Department
                            </div>

                            <div class="student-detail-value">
                                @student.Department
                            </div>

                        </div>


                        <div class="student-detail-item">

                            <div class="student-detail-label">
                                Enrolled Courses
                            </div>

                            <div class="student-detail-value">

                                <span class="badge bg-info text-dark">

                                    @student.Courses.Count

                                </span>

                            </div>

                        </div>

                    </div>

                </div>

            </div>


            <!-- Address -->

            <div class="col-lg-6">

                <div class="card h-100">

                    <div class="card-body">

                        <h5 class="fw-semibold mb-4">

                            <i class="bi bi-geo-alt me-2"></i>

                            Address

                        </h5>


                        @if (string.IsNullOrWhiteSpace(student.Address))
                        {
                            <p class="text-muted mb-0">

                                No address information available.

                            </p>
                        }
                        else
                        {
                            <p class="mb-0">

                                @student.Address

                            </p>
                        }

                    </div>

                </div>

            </div>


            <!-- Courses -->

            <div class="col-lg-6">

                <div class="card h-100">

                    <div class="card-body">

                        <h5 class="fw-semibold mb-4">

                            <i class="bi bi-book me-2"></i>

                            Courses

                        </h5>


                        @if (student.Courses.Any())
                        {
                            <div class="list-group list-group-flush">

                                @foreach (var course in student.Courses)
                                {
                                    <div class="list-group-item px-0">

                                        <i class="bi bi-bookmark me-2 text-primary"></i>

                                        @course

                                    </div>
                                }

                            </div>
                        }
                        else
                        {
                            <p class="text-muted mb-0">

                                This student is not enrolled
                                in any courses.

                            </p>
                        }

                    </div>

                </div>

            </div>

        </div>


        <!-- Academic Actions -->

        <div class="card mt-4">

            <div class="card-body">

                <h5 class="fw-semibold mb-4">
                    Academic Actions
                </h5>


                <div class="d-flex flex-wrap gap-2">

                    <button type="button"
                            class="btn btn-primary"
                            @onclick="OpenEnrollments">

                        <i class="bi bi-journal-plus me-1"></i>

                        Manage Enrollments

                    </button>


                    <button type="button"
                            class="btn btn-outline-primary"
                            @onclick="ViewTranscript">

                        <i class="bi bi-file-earmark-text me-1"></i>

                        View Transcript

                    </button>

                </div>

            </div>

        </div>

    }

</div>


@code {

    [Parameter]
    public int StudentId { get; set; }


    private StudentDetailsDto? student;

    private bool loading = true;


    protected override async Task OnInitializedAsync()
    {
        await LoadStudent();
    }


    private async Task LoadStudent()
    {
        loading = true;

        try
        {
            student =
                await StudentService
                    .GetStudentDetailsAsync(StudentId);
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex);

            Notification.Error(
                "Unable to load student details.");
        }
        finally
        {
            loading = false;
        }
    }


    private void EditStudent()
    {
        Navigation.NavigateTo(
            $"/students/edit/{StudentId}");
    }


    private void OpenEnrollments()
    {
        Navigation.NavigateTo(
            $"/students/{StudentId}/enrollments");
    }


    private void ViewTranscript()
    {
        Navigation.NavigateTo(
            $"/students/{StudentId}/transcript");
    }


    private void GoBack()
    {
        Navigation.NavigateTo("/students");
    }

}
