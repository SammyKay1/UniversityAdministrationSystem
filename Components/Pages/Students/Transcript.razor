@page "/students/{StudentId:int}/transcript"
@rendermode InteractiveServer

@using UniversityAdministrationSystem.Components.Shared
@using UniversityAdministrationSystem.Components.Shared.Feedback
@using UniversityAdministrationSystem.Components.Shared.Layout
@using Microsoft.AspNetCore.Authorization

@inject NavigationManager Navigation
@inject TranscriptService TranscriptService
@inject NotificationService Notification

@attribute [Authorize(Policy = Permissions.Students.View)]


<NotificationContainer />


@if (isLoading)
{
    <!-- Loading -->

    <div class="card">

        <div class="card-body text-center py-5">

            <div class="spinner-border text-primary" role="status">
            </div>

            <p class="text-muted mt-3 mb-0">
                Loading transcript...
            </p>

        </div>

    </div>
}
else if (transcript is null)
{
    <!-- Not Found -->

    <PageHeader Title="Student Transcript">

        <button class="btn btn-outline-secondary" @onclick="GoBack">

            <i class="bi bi-arrow-left me-1"></i>
            Back

        </button>

    </PageHeader>


    <PageCard>

        <div class="text-center py-5">

            <i class="bi bi-file-earmark-x fs-1 text-muted"></i>

            <h5 class="mt-3">
                Transcript not found
            </h5>

            <p class="text-muted">
                The transcript for this student could not be found.
            </p>

            <button class="btn btn-primary" @onclick="GoBack">

                <i class="bi bi-arrow-left me-1"></i>
                Back to Students

            </button>

        </div>

    </PageCard>
}
else
{
    <!-- Page Header -->

    <PageHeader Title="Student Transcript">

        <div class="d-flex gap-2">

            <button class="btn btn-outline-secondary" @onclick="GoBack">

                <i class="bi bi-arrow-left me-1"></i>
                Back

            </button>


            <button class="btn btn-primary" @onclick="OpenEnrollments">

                <i class="bi bi-journal-plus me-1"></i>
                Manage Enrollments

            </button>

        </div>

    </PageHeader>


    <!-- Student Header -->

    <PageCard>

        <div class="row align-items-center">

            <!-- Avatar -->

            <div class="col-md-2 text-center">

                <div class="rounded-circle bg-primary-subtle
                    text-primary d-flex align-items-center
                    justify-content-center mx-auto" style="width: 85px; height: 85px; font-size: 2rem;">

                    <i class="bi bi-person"></i>

                </div>

            </div>


            <!-- Student Information -->

            <div class="col-md-10">

                <h3 class="fw-bold mb-1">
                    @transcript.Header.StudentName
                </h3>

                <p class="text-muted mb-2">

                    <i class="bi bi-building me-1"></i>

                    @transcript.Header.Department

                </p>

                <span class="badge bg-primary-subtle text-primary">

                    <i class="bi bi-file-earmark-text me-1"></i>

                    Academic Transcript

                </span>

            </div>

        </div>

    </PageCard>


    <!-- Academic Summary -->

    <div class="row g-4 mt-1">

        <!-- Completed -->

        <div class="col-md-6 col-lg">

            <PageCard>

                <div class="d-flex align-items-center">

                    <div class="rounded-circle bg-success-subtle
                        text-success d-flex align-items-center
                        justify-content-center me-3" style="width: 45px; height: 45px;">

                        <i class="bi bi-check-circle"></i>

                    </div>

                    <div>

                        <div class="text-muted small">
                            Completed Courses
                        </div>

                        <div class="fs-4 fw-bold">
                            @transcript.Header.CompletedCourses
                        </div>

                    </div>

                </div>

            </PageCard>

        </div>


        <!-- Active -->

        <div class="col-md-6 col-lg">

            <PageCard>

                <div class="d-flex align-items-center">

                    <div class="rounded-circle bg-primary-subtle
                        text-primary d-flex align-items-center
                        justify-content-center me-3" style="width: 45px; height: 45px;">

                        <i class="bi bi-book"></i>

                    </div>

                    <div>

                        <div class="text-muted small">
                            Active Courses
                        </div>

                        <div class="fs-4 fw-bold">
                            @transcript.Header.ActiveCourses
                        </div>

                    </div>

                </div>

            </PageCard>

        </div>


        <!-- Dropped -->

        <div class="col-md-6 col-lg">

            <PageCard>

                <div class="d-flex align-items-center">

                    <div class="rounded-circle bg-danger-subtle
                        text-danger d-flex align-items-center
                        justify-content-center me-3" style="width: 45px; height: 45px;">

                        <i class="bi bi-x-circle"></i>

                    </div>

                    <div>

                        <div class="text-muted small">
                            Dropped Courses
                        </div>

                        <div class="fs-4 fw-bold">
                            @transcript.Header.DroppedCourses
                        </div>

                    </div>

                </div>

            </PageCard>

        </div>


        <!-- GPA -->

        <div class="col-md-6 col-lg">

            <PageCard>

                <div class="d-flex align-items-center">

                    <div class="rounded-circle bg-warning-subtle
                        text-warning d-flex align-items-center
                        justify-content-center me-3" style="width: 45px; height: 45px;">

                        <i class="bi bi-bar-chart"></i>

                    </div>

                    <div>

                        <div class="text-muted small">
                            GPA
                        </div>

                        <div class="fs-4 fw-bold">
                            @transcript.Header.GPA
                        </div>

                    </div>

                </div>

            </PageCard>

        </div>

    </div>


    <!-- Academic Standing -->

    <div class="mt-4">

        <PageCard>

            <div class="d-flex justify-content-between
                align-items-center">

                <div>

                    <h5 class="fw-semibold mb-1">

                        <i class="bi bi-mortarboard me-2"></i>

                        Academic Standing

                    </h5>

                    <p class="text-muted mb-0">
                        Current academic performance standing.
                    </p>

                </div>


                <span class="badge bg-primary-subtle text-primary fs-6">

                    @transcript.Header.AcademicStanding.DisplayName()

                </span>

            </div>

        </PageCard>

    </div>


    <!-- Transcript -->

    <div class="mt-4">

        <PageCard>

            <div class="d-flex justify-content-between
                align-items-center mb-4">

                <div>

                    <h5 class="fw-semibold mb-1">

                        <i class="bi bi-journal-text me-2"></i>

                        Academic Transcript

                    </h5>

                    <p class="text-muted mb-0">
                        Complete academic enrollment history.
                    </p>

                </div>

            </div>


            @if (!transcript.Courses.Any())
            {
                <!-- Empty State -->

                <div class="text-center py-5">

                    <i class="bi bi-journal-x fs-1 text-muted"></i>

                    <h6 class="mt-3">
                        No academic records
                    </h6>

                    <p class="text-muted mb-0">
                        This student does not have any course records yet.
                    </p>

                </div>
            }
            else
            {
                <!-- Transcript Table -->

                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">

                            <tr>

                                <th>
                                    Course Code
                                </th>

                                <th>
                                    Course
                                </th>

                                <th>
                                    Credit Hours
                                </th>

                                <th>
                                    Grade
                                </th>

                                <th>
                                    Status
                                </th>

                                <th>
                                    Enrollment Date
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            @foreach (var course in transcript.Courses)
                            {
                                <tr>

                                    <!-- Code -->

                                    <td>

                                        <span class="fw-semibold">
                                            @course.CourseCode
                                        </span>

                                    </td>


                                    <!-- Course -->

                                    <td>

                                        @course.CourseName

                                    </td>


                                    <!-- Credit Hours -->

                                    <td>

                                        @course.CreditHours

                                    </td>


                                    <!-- Grade -->

                                    <td>

                                        @if (course.Grade is not Grade.None)
                                        {
                                            <span class="badge bg-success-subtle text-success">
                                                @course.Grade
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                —
                                            </span>
                                        }

                                    </td>


                                    <!-- Status -->

                                    <td>

                                        <span class="@GetStatusClass(course.Status)">

                                            @course.Status

                                        </span>

                                    </td>


                                    <!-- Enrollment Date -->

                                    <td>

                                        @course.EnrollmentDate
                                        .ToString("dd MMM yyyy")

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }

        </PageCard>

    </div>

}


@code {

    [Parameter]
    public int StudentId { get; set; }


    private StudentTranscriptDto? transcript;

    private bool isLoading = true;


    protected override async Task OnInitializedAsync()
    {
        await LoadTranscript();
    }


    private async Task LoadTranscript()
    {
        try
        {
            isLoading = true;

            transcript =
                await TranscriptService
                    .GetTranscriptAsync(StudentId);
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex);

            Notification.Error(
                "Unable to load the student transcript.");
        }
        finally
        {
            isLoading = false;
        }
    }


    private string GetStatusClass(EnrollmentStatus status)
    {
        return status switch
        {
            EnrollmentStatus.Active =>
                "badge bg-primary-subtle text-primary",

            EnrollmentStatus.Completed =>
                "badge bg-success-subtle text-success",

            EnrollmentStatus.Dropped =>
                "badge bg-danger-subtle text-danger",

            _ =>
                "badge bg-secondary-subtle text-secondary"
        };
    }


    private void OpenEnrollments()
    {
        Navigation.NavigateTo(
            $"/students/{StudentId}/enrollments");
    }


    private void GoBack()
    {
        Navigation.NavigateTo(
            $"/students/details/{StudentId}");
    }

}
