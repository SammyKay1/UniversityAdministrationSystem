@page "/students/{StudentId:int}/enrollments"

@using UniversityAdministrationSystem.Components.Shared
@using UniversityAdministrationSystem.Components.Shared.Actions
@using UniversityAdministrationSystem.Components.Shared.Feedback
@using Microsoft.AspNetCore.Authorization

@inject NavigationManager Navigation
@inject EnrollmentService EnrollmentService
@inject NotificationService Notification

@attribute [Authorize(Policy = Permissions.Students.Enrollment)]


<PageTitle>Student Enrollments</PageTitle>

<NotificationContainer />


@if (student is null)
{
    <!-- Loading -->

    <div class="container-fluid">

        <div class="card">

            <div class="card-body text-center py-5">

                <div class="spinner-border text-primary"
                     role="status">

                    <span class="visually-hidden">
                        Loading...
                    </span>

                </div>

                <p class="text-muted mt-3 mb-0">
                    Loading student enrollments...
                </p>

            </div>

        </div>

    </div>
}
else
{
    <div class="container-fluid">

        <!-- Header -->

        <div class="d-flex justify-content-between align-items-start mb-4">

            <div>

                <div class="text-muted small mb-1">

                    <button type="button"
                            class="btn btn-link p-0 text-decoration-none"
                            @onclick="GoBack">

                        Students

                    </button>

                    <span class="mx-2">
                        /
                    </span>

                    Enrollments

                </div>


                <h1 class="mb-1">
                    Student Enrollments
                </h1>

                <p class="text-muted mb-0">
                    Manage courses and academic enrollment records.
                </p>

            </div>


            <button type="button"
                    class="btn btn-outline-secondary"
                    @onclick="GoBack">

                <i class="bi bi-arrow-left me-1"></i>

                Back to Student

            </button>

        </div>


        <!-- Student Summary -->

        <div class="card mb-4">

            <div class="card-body">

                <div class="row align-items-center">

                    <!-- Avatar -->

                    <div class="col-auto">

                        <div class="enrollment-student-avatar">

                            <i class="bi bi-person"></i>

                        </div>

                    </div>


                    <!-- Student -->

                    <div class="col">

                        <h4 class="mb-1">
                            @student.FullName
                        </h4>

                        <div class="text-muted">

                            <span>
                                Student ID: @StudentId
                            </span>

                            <span class="mx-2">
                                •
                            </span>

                            <span>
                                @student.Department
                            </span>

                        </div>

                    </div>


                    <!-- Status -->

                    <div class="col-auto">

                        <div class="text-end">

                            <div class="small text-muted mb-1">
                                Student Status
                            </div>

                            

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- Enroll Student -->

        <div class="card mb-4">

            <div class="card-header bg-white">

                <div class="d-flex align-items-center">

                    <div class="enrollment-section-icon">

                        <i class="bi bi-journal-plus"></i>

                    </div>


                    <div>

                        <h5 class="mb-1">
                            Enroll in a Course
                        </h5>

                        <p class="text-muted small mb-0">
                            Add this student to an available course.
                        </p>

                    </div>

                </div>

            </div>


            <div class="card-body">

                <EditForm Model="enrollment"
                          OnValidSubmit="EnrollStudent"
                          FormName="EnrollmentForm">

                    <DataAnnotationsValidator />


                    <div class="row g-4 align-items-end">

                        <!-- Course -->

                        <div class="col-lg-8">

                            <label class="form-label">

                                Course

                                <span class="text-danger">*</span>

                            </label>


                            <InputSelect class="form-select"
                                         @bind-Value="enrollment.CourseId">

                                <option value="0">
                                    Select a course
                                </option>


                                @foreach (var course in courses)
                                {
                                    <option value="@course.Id"
                                            disabled="@(course.AvailableSeats <= 0)">

                                        @course.CourseCode
                                        -
                                        @course.CourseName

                                        @(course.AvailableSeats <= 0
                                            ? " (FULL)"
                                            : $" ({course.AvailableSeats} seats available)")

                                    </option>
                                }

                            </InputSelect>


                            <ValidationMessage
                                For="@(() => enrollment.CourseId)" />

                        </div>


                        <!-- Enroll -->

                        <div class="col-lg-4">

                            <button type="submit"
                                    class="btn btn-primary w-100"
                                    disabled="@(SelectedCourse is null ||
                                               SelectedCourse.AvailableSeats <= 0)">

                                <i class="bi bi-plus-circle me-1"></i>

                                Enroll Student

                            </button>

                        </div>

                    </div>


                    <!-- Selected Course Information -->

                    @if (SelectedCourse is not null)
                    {
                        <div class="course-capacity-panel mt-4">

                            <div class="d-flex align-items-center mb-3">

                                <i class="bi bi-bar-chart-line me-2"></i>

                                <h6 class="mb-0">
                                    Course Capacity
                                </h6>

                            </div>


                            <div class="row g-3">

                                <div class="col-md-4">

                                    <div class="capacity-item">

                                        <div class="small text-muted">
                                            Capacity
                                        </div>

                                        <div class="fs-5 fw-semibold">
                                            @SelectedCourse.Capacity
                                        </div>

                                    </div>

                                </div>


                                <div class="col-md-4">

                                    <div class="capacity-item">

                                        <div class="small text-muted">
                                            Enrolled
                                        </div>

                                        <div class="fs-5 fw-semibold">
                                            @SelectedCourse.ActiveEnrollmentCount
                                        </div>

                                    </div>

                                </div>


                                <div class="col-md-4">

                                    <div class="capacity-item">

                                        <div class="small text-muted">
                                            Available
                                        </div>

                                        <div class="fs-5 fw-semibold">

                                            @SelectedCourse.AvailableSeats

                                        </div>

                                    </div>

                                </div>

                            </div>


                            @if (SelectedCourse.AvailableSeats <= 0)
                            {
                                <div class="alert alert-danger mt-3 mb-0">

                                    <i class="bi bi-exclamation-circle me-1"></i>

                                    This course is currently full.

                                </div>
                            }

                        </div>
                    }

                </EditForm>

            </div>

        </div>


        <!-- Current Enrollments -->

        <div class="card">

            <div class="card-header bg-white">

                <div class="d-flex justify-content-between align-items-center">

                    <div class="d-flex align-items-center">

                        <div class="enrollment-section-icon">

                            <i class="bi bi-journal-bookmark"></i>

                        </div>


                        <div>

                            <h5 class="mb-1">
                                Current Enrollments
                            </h5>

                            <p class="text-muted small mb-0">
                                Courses currently associated with this student.
                            </p>

                        </div>

                    </div>


                    <span class="badge bg-secondary">

                        @enrollments.Count()
                        @(enrollments.Count() == 1
                            ? "Course"
                            : "Courses")

                    </span>

                </div>

            </div>


            <div class="card-body p-0">

                @if (!enrollments.Any())
                {
                    <div class="text-center py-5">

                        <div class="enrollment-empty-icon">

                            <i class="bi bi-journal-x"></i>

                        </div>


                        <h6 class="mt-3">
                            No enrollments
                        </h6>

                        <p class="text-muted mb-0">
                            This student is not currently enrolled in any courses.
                        </p>

                    </div>
                }
                else
                {
                    <div class="table-responsive">

                        <table class="table table-hover align-middle mb-0">

                            <thead class="table-light">

                                <tr>

                                    <th>
                                        Course
                                    </th>

                                    <th>
                                        Code
                                    </th>

                                    <th>
                                        Enrolled
                                    </th>

                                    <th>
                                        Grade
                                    </th>

                                    <th>
                                        Status
                                    </th>

                                    <th class="text-end">
                                        Actions
                                    </th>

                                </tr>

                            </thead>


                            <tbody>

                                @foreach (var item in enrollments)
                                {
                                    <tr>

                                        <!-- Course -->

                                        <td>

                                            <div class="fw-semibold">
                                                @item.CourseName
                                            </div>

                                        </td>


                                        <!-- Code -->

                                        <td>

                                            <span class="text-muted">
                                                @item.CourseCode
                                            </span>

                                        </td>


                                        <!-- Date -->

                                        <td>

                                            @item.EnrollmentDate.ToShortDateString()

                                        </td>


                                        <!-- Grade -->

                                        <td>

                                            @if (item.Grade == Grade.None)
                                            {
                                                <span class="text-muted">
                                                    Not graded
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="fw-semibold">
                                                    @item.Grade
                                                </span>
                                            }

                                        </td>


                                        <!-- Status -->

                                        <td>

                                            <StatusBadge Status="item.Status" />

                                        </td>


                                        <!-- Actions -->

                                        <td class="text-end">

                                            <TableActions>

                                                <button type="button"
                                                        @onclick="() => OpenGradeDialog(item)">

                                                    <i class="bi bi-pencil-square me-2"></i>

                                                    Assign Grade

                                                </button>


                                                @if (item.Status == EnrollmentStatus.Active)
                                                {
                                                    <button type="button"
                                                            @onclick="() => CompleteEnrollment(item)">

                                                        <i class="bi bi-check-circle me-2"></i>

                                                        Complete

                                                    </button>


                                                    <button type="button"
                                                            class="text-danger"
                                                            @onclick="() => ShowDropDialog(item)">

                                                        <i class="bi bi-x-circle me-2"></i>

                                                        Drop

                                                    </button>
                                                }

                                            </TableActions>

                                        </td>

                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>
                }

            </div>

        </div>

    </div>
}


<!-- Grade Dialog -->

@if (showGradeDialog)
{
    <div class="modal-backdrop fade show"></div>

    <div class="modal fade show d-block"
         tabindex="-1"
         role="dialog">

        <div class="modal-dialog modal-dialog-centered">

            <div class="modal-content">

                <div class="modal-header">

                    <div>

                        <h5 class="modal-title">
                            Assign Grade
                        </h5>

                        @if (selectedEnrollment is not null)
                        {
                            <small class="text-muted">

                                @selectedEnrollment.CourseCode
                                -
                                @selectedEnrollment.CourseName

                            </small>
                        }

                    </div>


                    <button type="button"
                            class="btn-close"
                            aria-label="Close"
                            @onclick="CloseGradeDialog">
                    </button>

                </div>


                <EditForm Model="gradeDto"
                          OnValidSubmit="SaveGrade"
                          FormName="GradeForm">

                    <div class="modal-body">

                        <label class="form-label">
                            Grade
                        </label>


                        <InputSelect class="form-select"
                                     @bind-Value="gradeDto.Grade">

                            @foreach (var grade in Enum.GetValues<Grade>())
                            {
                                if (grade != Grade.None)
                                {
                                    <option value="@grade">
                                        @grade
                                    </option>
                                }
                            }

                        </InputSelect>

                    </div>


                    <div class="modal-footer">

                        <button type="button"
                                class="btn btn-outline-secondary"
                                @onclick="CloseGradeDialog">

                            Cancel

                        </button>


                        <button type="submit"
                                class="btn btn-primary">

                            <i class="bi bi-check-lg me-1"></i>

                            Save Grade

                        </button>

                    </div>

                </EditForm>

            </div>

        </div>

    </div>
}


<ConfirmDialog IsVisible="@showDropDialog"
               Message="@DropMessage"
               OnConfirmed="ConfirmDrop"
               OnCancelled="CloseDropDialog" />



@code {

    [Parameter]
    public int StudentId { get; set; }


    private StudentEnrollmentHeaderDto? student;

    private IEnumerable<CourseLookupDto> courses = [];

    private IEnumerable<EnrollmentListDto> enrollments = [];

    private EnrollmentCreateDto enrollment = new();


    private bool showGradeDialog;

    private bool showDropDialog;


    private EnrollmentListDto? selectedEnrollment;


    private AssignGradeDto gradeDto = new();


    protected override async Task OnInitializedAsync()
    {
        enrollment.StudentId = StudentId;

        await LoadPage();
    }


    private async Task LoadPage()
    {
        student =
            await EnrollmentService
                .GetStudentHeaderAsync(StudentId);


        courses =
            await EnrollmentService
                .GetCourseLookupAsync();


        enrollments =
            await EnrollmentService
                .GetStudentEnrollmentsAsync(StudentId);
    }


    private CourseLookupDto? SelectedCourse =>
        courses.FirstOrDefault(
            c => c.Id == enrollment.CourseId);


    private async Task EnrollStudent()
    {
        var result =
            await EnrollmentService
                .EnrollStudentAsync(enrollment);


        if (!result.Success)
        {
            Notification.Error(result.Message);
            return;
        }


        Notification.Success(
            "Course enrolled successfully.");


        enrollment.CourseId = 0;


        await RefreshEnrollments();
    }


    private async Task RefreshEnrollments()
    {
        courses =
            await EnrollmentService
                .GetCourseLookupAsync();


        enrollments =
            await EnrollmentService
                .GetStudentEnrollmentsAsync(StudentId);
    }


    private void OpenGradeDialog(
        EnrollmentListDto enrollment)
    {
        selectedEnrollment = enrollment;


        gradeDto = new AssignGradeDto
        {
            EnrollmentId = enrollment.Id,
            Grade = enrollment.Grade
        };


        showGradeDialog = true;
    }


    private async Task SaveGrade()
    {
        var result =
            await EnrollmentService
                .AssignGradeAsync(gradeDto);


        if (!result.Success)
        {
            Notification.Error(result.Message);
            return;
        }


        Notification.Success(
            "Grade assigned successfully.");


        showGradeDialog = false;


        enrollments =
            await EnrollmentService
                .GetStudentEnrollmentsAsync(StudentId);
    }


    private void CloseGradeDialog()
    {
        showGradeDialog = false;

        selectedEnrollment = null;
    }


    private void ShowDropDialog(
        EnrollmentListDto enrollment)
    {
        selectedEnrollment = enrollment;

        showDropDialog = true;
    }


    private string DropMessage =>
        selectedEnrollment is null
            ? "Drop this enrollment?"
            : $"Are you sure you want to drop " +
              $"'{selectedEnrollment.CourseCode} - " +
              $"{selectedEnrollment.CourseName}'?";


    private async Task ConfirmDrop()
    {
        if (selectedEnrollment is null)
            return;


        var result =
            await EnrollmentService
                .DropEnrollmentAsync(
                    selectedEnrollment.Id);


        showDropDialog = false;


        if (!result.Success)
        {
            Notification.Error(result.Message);
            return;
        }


        Notification.Success(
            "Course dropped successfully.");


        await RefreshEnrollments();


        selectedEnrollment = null;
    }


    private async Task CompleteEnrollment(
        EnrollmentListDto enrollment)
    {
        var result =
            await EnrollmentService
                .CompleteEnrollmentAsync(
                    enrollment.Id);


        if (!result.Success)
        {
            Notification.Error(result.Message);
            return;
        }


        Notification.Success(
            "Enrollment completed successfully.");


        await RefreshEnrollments();
    }


    private void CloseDropDialog()
    {
        showDropDialog = false;

        selectedEnrollment = null;
    }


    private void GoBack()
    {
        Navigation.NavigateTo(
            $"/students/details/{StudentId}");
    }

}
