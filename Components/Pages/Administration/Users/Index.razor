@page "/administration/users"

@using UniversityAdministrationSystem.Components.Shared.Actions
@using UniversityAdministrationSystem.Components.Shared.Lists
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization

@attribute [Authorize(Policy = Permissions.Users.View)]

@inject UserAdministrationService UserAdministrationService
@inject DialogService DialogService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation


<PageTitle>Users</PageTitle>


<div class="container-fluid">

    <!-- Header -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h1 class="mb-1">
                Users
            </h1>

            <p class="text-muted mb-0">
                Manage application users, roles and account access.
            </p>

        </div>


        <AuthorizeView Policy="@Permissions.Users.Create">

            <Authorized>

                <button type="button" class="btn btn-primary" @onclick="CreateUser">

                    <i class="bi bi-plus-lg me-1"></i>

                    Create User

                </button>

            </Authorized>

        </AuthorizeView>

    </div>


    <!-- Error -->

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">

            <i class="bi bi-exclamation-triangle-fill me-2"></i>

            @errorMessage

            <button type="button" class="btn-close" aria-label="Close" @onclick="ClearError">
            </button>

        </div>
    }


    <!-- Filters -->

    <div class="card mb-4">

        <div class="card-body">

            <div class="row g-3 align-items-end">

                <!-- Search -->

                <div class="col-md-7">

                    <label class="form-label">
                        Search Users
                    </label>

                    <div class="input-group">

                        <span class="input-group-text">
                            <i class="bi bi-search"></i>
                        </span>

                        <input class="form-control" placeholder="Search by name, username or email..."
                               value="@request.SearchTerm" @oninput="OnSearchChanged" />

                    </div>

                </div>


                <!-- Page Size  selector-->

                <div class="col-md-3">

                    <label class="form-label">
                        Users per page
                    </label>

                    <select class="form-select" value="@request.PageSize" @onchange="OnPageSizeChanged">

                        <option value="5">
                            5
                        </option>

                        <option value="10">
                            10
                        </option>

                        <option value="25">
                            25
                        </option>

                        <option value="50">
                            50
                        </option>

                    </select>

                </div>


                <!-- Reset -->

                <div class="col-md-2">

                    <button type="button" class="btn btn-outline-secondary w-100" disabled="@(!HasSearch)"
                            @onclick="ClearSearch">

                        <i class="bi bi-x-lg me-1"></i>

                        Clear

                    </button>

                </div>

            </div>

        </div>

    </div>


    <!-- Users -->

    <div class="card">

        <div class="card-header
            d-flex
            justify-content-between
            align-items-center">

            <div>

                <strong>
                    Application Users
                </strong>

                @if (result.TotalCount > 0)
                {
                    <span class="text-muted ms-2">
                        @result.TotalCount user(s)
                    </span>
                }

            </div>

        </div>


        <div class="card-body p-0">

            @if (isLoading)
            {
                <div class="text-center py-5">

                    <div class="spinner-border" role="status">

                        <span class="visually-hidden">
                            Loading...
                        </span>

                    </div>

                    <p class="text-muted mt-3 mb-0">
                        Loading users...
                    </p>

                </div>
            }
            else if (!result.Items.Any())
            {
                <div class="text-center py-5">

                    <i class="bi bi-people fs-1 text-muted"></i>

                    <h5 class="mt-3">
                        @(HasSearch
                            ? "No users found"
                            : "No users available")
                    </h5>

                    <p class="text-muted mb-0">

                        @(HasSearch  ? "No users match your search criteria."
                            : "There are currently no application users.")

                    </p>

                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">

                            <tr>

                                <th>
                                    User
                                </th>

                                <th>
                                    Email
                                </th>

                                <th>
                                    Roles
                                </th>

                                <th>
                                    Status
                                </th>

                                <th class="text-end">
                                    Actions
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            @foreach (var user in result.Items)
                            {
                                <tr>

                                    <!-- User -->

                                    <td>

                                        <div class="d-flex align-items-center">

                                            <div class="rounded-circle
                                                bg-primary
                                                text-white
                                                d-flex
                                                align-items-center
                                                justify-content-center
                                                me-3" style="width:40px;height:40px;">

                                                @GetInitials(user)

                                            </div>


                                            <div>

                                                <div class="fw-semibold">
                                                    @GetDisplayName(user)
                                                </div>

                                                <small class="text-muted">
                                                    @user.UserName
                                                </small>

                                            </div>

                                        </div>

                                    </td>


                                    <!-- Email -->

                                    <td>

                                        @if (string.IsNullOrWhiteSpace(user.Email))
                                        {
                                            <span class="text-muted">
                                                Not provided
                                            </span>
                                        }
                                        else
                                        {
                                            <div>

                                                <a href="mailto:@user.Email">
                                                    @user.Email
                                                </a>

                                                @if (user.EmailConfirmed)
                                                {
                                                    <span class="badge bg-success ms-2">
                                                        Verified
                                                    </span>
                                                }

                                            </div>
                                        }

                                    </td>


                                    <!-- Roles -->

                                    <td>

                                        @if (user.Roles.Count == 0)
                                        {
                                            <span class="text-muted">
                                                No roles
                                            </span>
                                        }
                                        else
                                        {
                                            @foreach (var role in user.Roles)
                                            {
                                                <span class="badge bg-secondary me-1">
                                                    @role
                                                </span>
                                            }
                                        }

                                    </td>


                                    <!-- Status -->

                                    <td>

                                        @if (user.IsLockedOut)
                                        {
                                            <span class="badge bg-danger">

                                                <i class="bi bi-lock-fill me-1"></i>

                                                Locked

                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success">

                                                <i class="bi bi-check-circle-fill me-1"></i>

                                                Active

                                            </span>
                                        }

                                    </td>


                                    <!-- Actions -->

                                    <td class="text-end">

                                        <TableActions>

                                            <AuthorizeView Policy="@Permissions.Users.Edit">

                                                <Authorized>

                                                    <TableAction Icon="bi-pencil"  OnClick="() => EditUser(user.Id)" >
                                                        View
                                                    </TableAction>

                                                </Authorized>

                                            </AuthorizeView>


                                            <AuthorizeView Policy="@Permissions.Users.ManageRoles">

                                                <Authorized>

                                                    <TableAction Icon="bi-shield-check"     OnClick="() => ManageRoles(user.Id)" >
                                                                 Manage Roles
                                                                 </TableAction>

                                                </Authorized>

                                            </AuthorizeView>


                                            <AuthorizeView Policy="@Permissions.Users.Edit">

                                                <Authorized>

                                                    @if (user.IsLockedOut)
                                                    {
                                                        <TableAction Icon="bi-unlock"  CssClass="text-success"
                                                                     OnClick="() => UnlockUserAsync(user)" >
                                                                     Unlock
                                                                     </TableAction>
                                                    }
                                                    else
                                                    {
                                                        <TableAction Icon="bi-lock"  CssClass="text-warning"
                                                                     OnClick="() => LockUserAsync(user)" >
                                                                        Lock
                                                                     </TableAction>
                                                    }

                                                </Authorized>

                                            </AuthorizeView>


                                            <AuthorizeView Policy="@Permissions.Users.Delete">

                                                <Authorized>

                                                    <TableAction Icon="bi-trash" CssClass="text-danger"
                                                                 OnClick="() => DeleteUserAsync(user)" >
                                                                    Delete
                                                                 </TableAction>

                                                </Authorized>

                                            </AuthorizeView>

                                        </TableActions>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }

        </div>


        <!-- Pagination -->

        @if (!isLoading && result.TotalCount > 0)
        {
            <div class="card-footer">

                <div class="d-flex
                    justify-content-between
                    align-items-center">

                    <div class="text-muted">

                        Showing

                        <strong>
                            @GetFirstItemNumber()
                        </strong>

                        -

                        <strong>
                            @GetLastItemNumber()
                        </strong>

                        of

                        <strong>
                            @result.TotalCount
                        </strong>

                        users

                    </div>


                    <Pager CurrentPage="@result.PageNumber" TotalPages="@result.TotalPages" OnPageChanged="OnPageChanged" />

                </div>

            </div>
        }

    </div>

</div>


@code {

    private UserListRequest request = new();

    private PagedResult<UserDto> result = new();

    private bool isLoading = true;

    private string? errorMessage;


    private bool HasSearch =>
        !string.IsNullOrWhiteSpace(request.SearchTerm);


    protected override async Task OnInitializedAsync()
    {
        await LoadUsersAsync();
    }


    private async Task LoadUsersAsync()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            result =
                await UserAdministrationService
                    .GetUsersAsync(request);
        }
        catch (Exception)
        {
            errorMessage =
                "Unable to load users. Please try again.";
        }
        finally
        {
            isLoading = false;
        }
    }


    private async Task OnSearchChanged(
        ChangeEventArgs e)
    {
        request.SearchTerm =
            e.Value?.ToString() ?? string.Empty;

        request.PageNumber = 1;

        await LoadUsersAsync();
    }


    private async Task OnPageSizeChanged(
        ChangeEventArgs e)
    {
        if (!int.TryParse(
            e.Value?.ToString(),
            out var pageSize))
        {
            return;
        }

        request.PageSize = pageSize;

        request.PageNumber = 1;

        await LoadUsersAsync();
    }


    private async Task OnPageChanged(int page)
    {
        request.PageNumber = page;

        await LoadUsersAsync();
    }


    private void EditUser(string userId)
    {
        Navigation.NavigateTo(
            $"/administration/users/edit/{userId}");
    }


    private void ManageRoles(string userId)
    {
        Navigation.NavigateTo(
            $"/administration/users/{userId}/roles");
    }





    private async Task ClearSearch()
    {
        if (!HasSearch)
            return;

        request.SearchTerm = string.Empty;

        request.PageNumber = 1;

        await LoadUsersAsync();
    }


    private void ClearError()
    {
        errorMessage = null;
    }


    private static string GetDisplayName(UserDto user)
    {
        if (!string.IsNullOrWhiteSpace(user.FullName))
            return user.FullName;

        return user.UserName;
    }


    private static string GetInitials(UserDto user)
    {
        var name = GetDisplayName(user);

        if (string.IsNullOrWhiteSpace(name))
            return "?";

        var parts =
            name.Split(
                ' ',
                StringSplitOptions.RemoveEmptyEntries);

        if (parts.Length == 1)
            return parts[0][0].ToString().ToUpperInvariant();

        return $"{parts[0][0]}{parts[^1][0]}"
            .ToUpperInvariant();
    }


    private int GetFirstItemNumber()
    {
        if (result.TotalCount == 0)
            return 0;

        return
            ((result.PageNumber - 1)
            * result.PageSize) + 1;
    }


    private int GetLastItemNumber()
    {
        return Math.Min(
            result.PageNumber * result.PageSize,
            result.TotalCount);
    }


    private void CreateUser()
    {
        Navigation.NavigateTo(
            "/administration/users/create");
    }


    private async Task LockUserAsync(UserDto user)
    {
        errorMessage = null;

        var operationResult =
            await UserAdministrationService
                .LockUserAsync(user.Id);

        if (operationResult.Succeeded)
        {
            await LoadUsersAsync();
            return;
        }

        errorMessage =
            string.Join(
                " ",
                operationResult.Errors
                    .Select(x => x.Description));
    }


    private async Task UnlockUserAsync(UserDto user)
    {
        errorMessage = null;

        var operationResult =
            await UserAdministrationService
                .UnlockUserAsync(user.Id);

        if (operationResult.Succeeded)
        {
            await LoadUsersAsync();
            return;
        }

        errorMessage =
            string.Join(
                " ",
                operationResult.Errors
                    .Select(x => x.Description));
    }


    private async Task DeleteUserAsync(UserDto user)
    {
        errorMessage = null;


        var authState =
            await AuthenticationStateProvider
                .GetAuthenticationStateAsync();


        var currentUserId =
            authState.User
                .FindFirst(
                    System.Security.Claims.ClaimTypes.NameIdentifier)
                ?.Value;


        if (currentUserId == user.Id)
        {
            errorMessage =
                "You cannot delete your own account.";

            return;
        }


        var confirmed =
            await DialogService.ConfirmAsync(
                "Delete User",
                $"Are you sure you want to delete " +
                $"'{user.UserName}'?");


        if (!confirmed)
            return;


        var operationResult =
            await UserAdministrationService
                .DeleteUserAsync(user.Id);


        if (operationResult.Succeeded)
        {
            await LoadUsersAsync();
            return;
        }


        errorMessage =
            string.Join(
                " ",
                operationResult.Errors
                    .Select(x => x.Description));
    }

}
