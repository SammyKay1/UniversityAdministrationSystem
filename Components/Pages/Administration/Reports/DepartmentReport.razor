@page "/reports/departments"

@using UniversityAdministrationSystem.Components.Shared
@using UniversityAdministrationSystem.Components.Shared.Feedback
@using UniversityAdministrationSystem.Components.Shared.Layout
@using UniversityAdministrationSystem.Components.Shared.Reports

@inject ReportService ReportService
@inject NotificationService Notification
@inject NavigationManager Navigation

@inject DepartmentService DepartmentService

@*
@attribute [Authorize(Policy = Permissions.Reports.View)]  *@


<PageHeader Title="Department Report" />

<NotificationContainer />

@* Department filters*@
        <ReportsToolbar Title="Report Filters" Description="Filter department statistics." OnReset="ResetFilters"
                        OnRefresh="LoadReport">

            <div class="col-md-4">

                <label class="form-label">
                    Department
                </label>

                <InputSelect class="form-select" @bind-Value="selectedDepartmentId" @bind-Value:after="ApplyFilters">

                    <option value="0">
                        All Departments
                    </option>

                    @foreach (var department in departmentReport)
                    {
                        <option value="@department.DepartmentId">
                            @department.DepartmentName
                        </option>
                    }

                </InputSelect>

            </div>

        </ReportsToolbar>

<div class="row g-4 mb-4">

    <div class="col-xl-3 col-md-6">

        <div class="card border-0 shadow-sm h-100">

            <div class="card-body">

                <div class="d-flex justify-content-between align-items-start">

                    <div>
                        <p class="text-muted mb-1">
                            Departments
                        </p>

                        <h3 class="fw-bold mb-0">
                            @TotalDepartments
                        </h3>
                    </div>

                    <div class="rounded-circle bg-primary-subtle
                        p-3">

                        <i class="bi bi-building text-primary fs-4"></i>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <div class="col-xl-3 col-md-6">

        <div class="card border-0 shadow-sm h-100">

            <div class="card-body">

                <div class="d-flex justify-content-between align-items-start">

                    <div>
                        <p class="text-muted mb-1">
                            Students
                        </p>

                        <h3 class="fw-bold mb-0">
                            @TotalStudents
                        </h3>
                    </div>

                    <div class="rounded-circle bg-success-subtle
                        p-3">

                        <i class="bi bi-people text-success fs-4"></i>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <div class="col-xl-3 col-md-6">

        <div class="card border-0 shadow-sm h-100">

            <div class="card-body">

                <div class="d-flex justify-content-between align-items-start">

                    <div>
                        <p class="text-muted mb-1">
                            Teachers
                        </p>

                        <h3 class="fw-bold mb-0">
                            @TotalTeachers
                        </h3>
                    </div>

                    <div class="rounded-circle bg-warning-subtle
                        p-3">

                        <i class="bi bi-person-workspace text-warning fs-4"></i>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <div class="col-xl-3 col-md-6">

        <div class="card border-0 shadow-sm h-100">

            <div class="card-body">

                <div class="d-flex justify-content-between align-items-start">

                    <div>
                        <p class="text-muted mb-1">
                            Courses
                        </p>

                        <h3 class="fw-bold mb-0">
                            @TotalCourses
                        </h3>
                    </div>

                    <div class="rounded-circle bg-info-subtle
                        p-3">

                        <i class="bi bi-book text-info fs-4"></i>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>

<PageCard>

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h5 class="mb-1">Department Overview</h5>

            <p class="text-muted mb-0">
                Summary of students, teachers, courses and enrollments
                across departments.
            </p>
        </div>

    </div>


    @if (loading)
    {
        <div class="text-center py-5">

            <div class="spinner-border" role="status">
                <span class="visually-hidden">
                    Loading...
                </span>
            </div>

            <p class="text-muted mt-3">
                Loading department report...
            </p>

        </div>
    }
    else if (!departmentReport.Any())
    {
        <div class="text-center py-5">

            <i class="bi bi-bar-chart fs-1 text-muted"></i>

            <h5 class="mt-3">
                No department data
            </h5>

            <p class="text-muted">
                There are currently no departments available
                for reporting.
            </p>

        </div>
    }
    else
    {
        @* Department report table *@

        <div class="table-responsive">

            <table class="table table-hover align-middle">

                <thead>

                    <tr>

                        <th>Department</th>

                        <th>Code</th>

                        <th class="text-center">
                            Students
                        </th>

                        <th class="text-center">
                            Teachers
                        </th>

                        <th class="text-center">
                            Courses
                        </th>

                        <th class="text-center">
                            Enrollments
                        </th>

                    </tr>

                </thead>

                <tbody>

                    @foreach (var department in filteredReport)
                    {
                        <tr>

                            <td>
                                <strong>
                                    @department.DepartmentName
                                </strong>
                            </td>

                            <td>
                                <span class="badge bg-light text-dark">
                                    @department.DepartmentCode
                                </span>
                            </td>

                            <td class="text-center">
                                @department.StudentCount
                            </td>

                            <td class="text-center">
                                @department.TeacherCount
                            </td>

                            <td class="text-center">
                                @department.CourseCount
                            </td>

                            <td class="text-center">
                                @department.EnrollmentCount
                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>
    }

</PageCard>


@code {

    private IEnumerable<DepartmentReportDto> departmentReport = [];
    private IEnumerable<DepartmentLookUpDto> departmentLookup = [];

  
    private int selectedDepartmentId;
    private IEnumerable<DepartmentReportDto> filteredReport = [];
    private bool loading;

    [Parameter]
    public bool IsLoading { get; set; }


    protected override async Task OnInitializedAsync()
    {
        //Load departments
        departmentLookup = await DepartmentService.GetDepartmentsAsync();

        //Load reports
        await LoadReport();
    }


    private async Task LoadReport()
    {
        loading = true;

        try
        {
            departmentReport = await ReportService.GetDepartmentReportAsync();

            ApplyFilters();
        }
        catch (Exception ex)
        {
            Notification.Error(
                "Unable to load the department report.");

        }
        finally
        {
            loading = false;
        }
    }

    private void ApplyFilters()
    {
        filteredReport = selectedDepartmentId == 0 ? departmentReport
                : departmentReport.Where(x => x.DepartmentId == selectedDepartmentId);
    }

    private void ResetFilters()
    {
        selectedDepartmentId = 0;

        ApplyFilters();
    }


    private int TotalDepartments => departmentReport.Count();

    private int TotalStudents => departmentReport.Sum(x => x.StudentCount);

    private int TotalTeachers => departmentReport.Sum(x => x.TeacherCount);

    private int TotalCourses => departmentReport.Sum(x => x.CourseCount);

    private int TotalEnrollments => departmentReport.Sum(x => x.EnrollmentCount);




}
