@page "/reports/academic-performance"

@using UniversityAdministrationSystem.Components.Shared
@using UniversityAdministrationSystem.Components.Shared.Feedback
@using UniversityAdministrationSystem.Components.Shared.Layout
@using UniversityAdministrationSystem.Components.Shared.Reports

@inject ReportService ReportService
@inject NotificationService Notification

@attribute [Authorize(Policy = Permissions.Reports.View)]

@inject DepartmentService DepartmentService
@inject CourseService CourseService


<PageHeader Title="Academic Performance" />

<NotificationContainer />

<ReportsToolbar Title="Course Performance" Description="Academic performance across courses." IsLoading="loading"
               OnReset="ResetFilters" OnRefresh="LoadReport">

    <div class="col-md-4">

        <label class="form-label">
            Department
        </label>

        <InputSelect class="form-select" @bind-Value="selectedDepartmentId" @bind-Value:after="ApplyFilters">

            <option value="0">
                All Departments
            </option>

            @foreach (var department in departments)
            {
                <option value="@department.Id">
                    @department.Name
                </option>
            }

        </InputSelect>

    </div>


    <div class="col-md-4">

        <label class="form-label">
            Course
        </label>

        <InputSelect class="form-select" @bind-Value="selectedCourseId" @bind-Value:after="ApplyFilters">

            <option value="0">
                All Courses
            </option>

            @foreach (var course in courses)
            {
                <option value="@course.Id">
                    @course.CourseCode -
                    @course.CourseName
                </option>
            }

        </InputSelect>

    </div>


    <div class="col-md-4">

        <label class="form-label">
            Grade
        </label>

        <InputSelect class="form-select" @bind-Value="selectedGrade" @bind-Value:after="ApplyFilters">

            <option value="">
                All Grades
            </option>

            @foreach (var grade in Enum.GetValues<Grade>())
            {
                if (grade != Grade.None)
                {
                    <option value="@grade">
                        @grade
                    </option>
                }
            }

        </InputSelect>

    </div>

</ReportsToolbar>


<div class="row g-4 mb-4">

    <div class="col-xl-3 col-md-6">

        <div class="card border-0 shadow-sm h-100">

            <div class="card-body">

                <p class="text-muted mb-1">
                    Graded Enrollments
                </p>

                <h3 class="fw-bold mb-0">
                    @TotalGraded
                </h3>

            </div>

        </div>

    </div>


    <div class="col-xl-3 col-md-6">

        <div class="card border-0 shadow-sm h-100">

            <div class="card-body">

                <p class="text-muted mb-1">
                    Pending Grades
                </p>

                <h3 class="fw-bold text-warning mb-0">
                    @TotalPending
                </h3>

            </div>

        </div>

    </div>


    <div class="col-xl-3 col-md-6">

        <div class="card border-0 shadow-sm h-100">

            <div class="card-body">

                <p class="text-muted mb-1">
                    Passed
                </p>

                <h3 class="fw-bold text-success mb-0">
                    @TotalPassed
                </h3>

            </div>

        </div>

    </div>


    <div class="col-xl-3 col-md-6">

        <div class="card border-0 shadow-sm h-100">

            <div class="card-body">

                <p class="text-muted mb-1">
                    Failed
                </p>

                <h3 class="fw-bold text-danger mb-0">
                    @TotalFailed
                </h3>

            </div>

        </div>

    </div>

</div>


<PageCard>

    @if (loading)
    {
        <div class="text-center py-5">

            <div class="spinner-border"></div>

            <p class="text-muted mt-3">
                Loading academic performance...
            </p>

        </div>
    }
    else if (!report.Any())
    {
        <div class="text-center py-5">

            <i class="bi bi-mortarboard fs-1 text-muted"></i>

            <h5 class="mt-3">
                No academic data
            </h5>

            <p class="text-muted">
                There is currently no academic performance data
                to display.
            </p>

        </div>
    }
    else
    {
        <div class="table-responsive">

            <table class="table table-hover align-middle">

                <thead>

                    <tr>

                        <th>Course</th>

                        <th>Department</th>

                        <th class="text-center">
                            Graded
                        </th>

                        <th class="text-center">
                            Pending
                        </th>

                        <th class="text-center">
                            Passed
                        </th>

                        <th class="text-center">
                            Failed
                        </th>

                        <th class="text-center">
                            Pass Rate
                        </th>

                    </tr>

                </thead>


                <tbody>

                    @foreach (var item in report)
                    {
                        <tr>

                            <td>

                                <div class="fw-semibold">
                                    @item.CourseCode
                                </div>

                                <small class="text-muted">
                                    @item.CourseName
                                </small>

                            </td>


                            <td>
                                @item.DepartmentName
                            </td>


                            <td class="text-center">
                                @item.GradedCount
                            </td>


                            <td class="text-center">

                                @if (item.PendingGradeCount > 0)
                                {
                                    <span class="badge bg-warning-subtle text-warning">
                                        @item.PendingGradeCount
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted">
                                        0
                                    </span>
                                }

                            </td>


                            <td class="text-center">

                                <span class="badge bg-success-subtle text-success">

                                    @item.PassedCount

                                </span>

                            </td>


                            <td class="text-center">

                                @if (item.FailedCount > 0)
                                {
                                    <span class="badge bg-danger-subtle text-danger">
                                        @item.FailedCount
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted">
                                        0
                                    </span>
                                }

                            </td>


                            <td class="text-center">

                                @if (item.GradedCount == 0)
                                {
                                    <span class="text-muted">
                                        —
                                    </span>
                                }
                                else
                                {
                                    <strong>
                                        @item.PassRate.ToString("0.0")%
                                    </strong>
                                }

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>
    }

</PageCard>


@code {

    private IEnumerable<AcademicPerformanceReportDto> report = [];

    private IEnumerable<DepartmentLookUpDto> departments = [];

    private IEnumerable<CourseLookupDto> courses = [];

    private IEnumerable<AcademicPerformanceReportDto> allReport = [];

    //private IEnumerable<AcademicPerformanceReportDto> report = [];

    private int selectedDepartmentId;

    private int selectedCourseId;

    private Grade? selectedGrade;
    private bool loading;


    private int TotalGraded =>
        report.Sum(x => x.GradedCount);


    private int TotalPending =>
        report.Sum(x => x.PendingGradeCount);


    private int TotalPassed =>
        report.Sum(x => x.PassedCount);


    private int TotalFailed =>
        report.Sum(x => x.FailedCount);


    protected override async Task OnInitializedAsync()
    {
        departments = await DepartmentService.GetDepartmentsAsync();

        courses = await CourseService.GetLookupAsync();

        await LoadReport();
    }


    private async Task LoadReport()
    {
        loading = true;

        try
        {
            allReport =
                await ReportService
                    .GetAcademicPerformanceReportAsync();

            ApplyFilters();
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex);

            Notification.Error(
                "Unable to load the academic performance report.");
        }
        finally
        {
            loading = false;
        }
    }


    private void ApplyFilters()
    {
        IEnumerable<AcademicPerformanceReportDto> query =
            allReport;

        if (selectedDepartmentId > 0)
        {
            query = query.Where(x =>
                x.DepartmentId == selectedDepartmentId);
        }

        if (selectedCourseId > 0)
        {
            query = query.Where(x =>
                x.CourseId == selectedCourseId);
        }

        if (selectedGrade.HasValue)
        {
            query = selectedGrade.Value switch
            {
                Grade.A =>
                    query.Where(x => x.ACount > 0),

                Grade.B =>
                    query.Where(x => x.BCount > 0),

                Grade.C =>
                    query.Where(x => x.CCount > 0),

                Grade.D =>
                    query.Where(x => x.DCount > 0),

                Grade.F =>
                    query.Where(x => x.FCount > 0),

                _ => query
            };
        }

        report = query.ToList();
    }


    private void ResetFilters()
    {
        selectedDepartmentId = 0;
        selectedCourseId = 0;
        selectedGrade = null;

        ApplyFilters();
    }




}
