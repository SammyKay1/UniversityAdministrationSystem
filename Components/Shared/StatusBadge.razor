
<span class="badge @GetCssClass()">
    @Status
</span>

@code {

    [Parameter]
    public EnrollmentStatus Status { get; set; }


    private string GetCssClass()
    {
        return Status switch
        {
            EnrollmentStatus.Active =>
                "bg-success",

            EnrollmentStatus.Completed =>
                "bg-primary",

            EnrollmentStatus.Dropped =>
                "bg-danger",

            _ =>
                "bg-secondary"
        };
    }

}
