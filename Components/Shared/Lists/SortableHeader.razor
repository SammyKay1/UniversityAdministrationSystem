
<th role="button"  style="cursor:pointer"  @onclick="SortClicked">

    @Title

    @if (CurrentColumn == Column)
    {
        @if (Descending)
        {
            <span> ▼ </span>
        }
        else
        {
            <span> ▲ </span>
        }
    }

</th>

@code {

    [Parameter] 
    public string Title { get; set; } = "";

    [Parameter] 
    public string Column { get; set; } = "";

    [Parameter] 
    public string? CurrentColumn { get; set; }

    [Parameter] 
    public bool Descending { get; set; }

    [Parameter] 
    public EventCallback<string> OnSort { get; set; }

    private async Task SortClicked()
    {
        await OnSort.InvokeAsync(Column);
    }

}
